[Unit]
Description=Parviz Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=parviz
Group=parviz
WorkingDirectory=/opt/parviz
ExecStart=/opt/parviz/.venv/bin/python /opt/parviz/bot.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
